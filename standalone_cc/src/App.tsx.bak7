import React, { useState } from 'react';
import { PlayerPreview } from './components/ui/previews/PlayerPreview';
import { ControlPanel } from './components/ui/panels/ControlPanel';
import { BODY_PRESETS, OUTFIT_PRESETS } from './data/constants';
import { DEFAULT_CONFIG } from './types';
import type { PlayerConfig, PlayerInput } from './types';
import './index.css';

const DEFAULT_INPUT: Partial<PlayerInput> = {
    x: 0,
    y: 0,
    isRunning: false,
    jump: false,
    isDead: false,
    isPickingUp: false,
    attack1: false,
    attack2: false,
    interact: false,
    combat: false,
    toggleFirstPerson: false,
    wave: false,
    leftHandWave: false,
    summon: false,
    toggleBuilder: false,
    rotateGhost: false,
    fireball: false,
    crouch: false
};

const INITIAL_CONFIG: PlayerConfig = {
  ...DEFAULT_CONFIG,
  ...BODY_PRESETS.average,
  ...OUTFIT_PRESETS.peasant,
  bodyType: 'male',
  bodyVariant: 'average',
  hairStyle: 'crew',
  hairColor: '#2b1d16',
  skinColor: '#d8b89a',
  eyeColor: '#3c5e8f',
  scleraColor: '#f2f4f7',
  pupilColor: '#111111',
  lipColor: '#c79b84',
  shirtColor: '#6f4e37',
  shirtColor2: '#caa472',
  pantsColor: '#3b2d24',
  bootsColor: '#2a1b14',
  chinSize: 0.62,
  chinLength: 0.9,
  chinForward: 0.0,
  chinHeight: -0.02,
  noseHeight: 0.0,
  noseForward: -0.01,
  irisScale: 0.4,
  pupilScale: 0.28,
  maxillaScaleX: 0.92,
  maxillaScaleY: 1.12,
  maxillaScaleZ: 1.35,
  maxillaOffsetY: -0.02,
  maxillaOffsetZ: -0.04,
  upperLipWidth: 0.78,
  upperLipHeight: 0.76,
  upperLipThick: 0.9,
  upperLipOffsetY: 0.015,
  upperLipOffsetZ: 0.002,
  lowerLipWidth: 0.92,
  lowerLipHeight: 0.9,
  lowerLipThick: 0.9,
  lowerLipOffsetY: -0.07,
  lowerLipOffsetZ: 0.07,
  timeOfDay: 16.8,
  isAutoTime: false,
};

function App() {
  const [config, setConfig] = useState<PlayerConfig>(INITIAL_CONFIG);
  const [manualInput, setManualInput] = useState<Partial<PlayerInput>>(DEFAULT_INPUT);
  const [isDeadUI, setIsDeadUI] = useState(false);

  const handleDeathToggle = () => {
      setManualInput(prev => ({ ...prev, isDead: !prev.isDead }));
      setIsDeadUI(prev => !prev);
  };

  const triggerAction = (key: keyof PlayerInput) => {
      setManualInput(prev => ({ ...prev, [key]: true }));
      setTimeout(() => setManualInput(prev => ({ ...prev, [key]: false })), 100);
  };

  return (
    <div className="w-screen h-screen bg-slate-950 overflow-hidden text-slate-50 flex flex-col relative">
      <div className="absolute inset-0">
         <PlayerPreview config={config} />
      </div>
      
      <ControlPanel
          config={config}
          manualInput={manualInput}
          isDeadUI={isDeadUI}
          setConfig={setConfig}
          setManualInput={setManualInput}
          handleDeathToggle={handleDeathToggle}
          triggerAction={triggerAction}
          onExport={() => console.log('Export model')}
          onSpawnAnimals={() => console.log('Spawn animals')}
          onUndo={() => console.log('Undo')}
          onRedo={() => console.log('Redo')}
          canUndo={false}
          canRedo={false}
      />
    </div>
  )
}

export default App;
