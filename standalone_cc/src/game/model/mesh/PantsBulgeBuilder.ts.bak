import * as THREE from 'three';

interface PantsBulgeOptions {
    position?: { x: number; y: number; z: number };
    scale?: { x: number; y: number; z: number };
    rotationX?: number;
}

export class PantsBulgeBuilder {
    static build(material: THREE.Material, options: PantsBulgeOptions = {}): THREE.Mesh {
        const geo = new THREE.SphereGeometry(0.062, 18, 14);
        const pos = geo.attributes.position;
        const v = new THREE.Vector3();

        for (let i = 0; i < pos.count; i++) {
            v.fromBufferAttribute(pos, i);

            // Flatten the back into the pelvis while shaping a front-heavy cloth bulge.
            if (v.z < 0) {
                v.z *= 0.45;
            } else {
                const centerBias = Math.max(0, 1.0 - Math.abs(v.x) / 0.055);
                const lowerBias = THREE.MathUtils.clamp((0.05 - v.y) / 0.11, 0, 1);
                const upperBias = THREE.MathUtils.clamp((v.y + 0.02) / 0.08, 0, 1);

                v.z += centerBias * lowerBias * 0.05;
                v.z += centerBias * upperBias * 0.016;
                v.y -= centerBias * lowerBias * 0.02;
            }

            // Keep the form narrow where it meets the inseam.
            if (v.y < -0.015) {
                const t = THREE.MathUtils.clamp((-0.015 - v.y) / 0.06, 0, 1);
                v.x *= 1.0 - t * 0.18;
            }

            pos.setXYZ(i, v.x, v.y, v.z);
        }

        geo.computeVertexNormals();

        const mesh = new THREE.Mesh(geo, material);
        const position = options.position ?? { x: 0, y: -0.086, z: 0.116 };
        const scale = options.scale ?? { x: 0.72, y: 1.06, z: 0.9 };

        mesh.name = 'pantsBulge';
        mesh.castShadow = true;
        mesh.position.set(position.x, position.y, position.z);
        mesh.scale.set(scale.x, scale.y, scale.z);
        mesh.rotation.x = options.rotationX ?? -0.42;

        return mesh;
    }
}
