import * as THREE from 'three';
import { PlayerConfig } from '../../../../types';

export class PlagueDoctorMaskBuilder {
    static build(config: PlayerConfig): THREE.Group {
        const group = new THREE.Group();
        group.name = 'PlagueDoctorMask';

        const leatherMat = new THREE.MeshStandardMaterial({
            color: config.plagueMaskColor,
            roughness: 0.88,
            metalness: 0.08,
            side: THREE.DoubleSide
        });
        leatherMat.userData.plagueMaskPart = 'leather';

        const trimMat = new THREE.MeshStandardMaterial({
            color: config.plagueMaskTrimColor,
            roughness: 0.24,
            metalness: 0.9
        });
        trimMat.userData.plagueMaskPart = 'trim';

        const lensMat = new THREE.MeshStandardMaterial({
            color: config.plagueMaskLensColor,
            roughness: 0.12,
            metalness: 0.1,
            transparent: true,
            opacity: 0.58
        });
        lensMat.userData.plagueMaskPart = 'lens';

        const shell = new THREE.Mesh(new THREE.SphereGeometry(0.225, 40, 28, 0, Math.PI * 2, 0, Math.PI * 0.6), leatherMat);
        shell.position.set(0, -0.035, 0.01);
        shell.scale.set(1.02, 0.94, 1.06);
        shell.castShadow = true;
        group.add(shell);

        const beak = new THREE.Mesh(new THREE.ConeGeometry(0.11, 0.44, 24, 1, false), leatherMat);
        beak.rotation.x = Math.PI / 2;
        beak.position.set(0, -0.09, 0.22);
        beak.scale.set(0.95, 0.95, 1.12);
        beak.castShadow = true;
        group.add(beak);

        const beakTip = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.014, 0.06, 20), trimMat);
        beakTip.rotation.x = Math.PI / 2;
        beakTip.position.set(0, -0.09, 0.465);
        group.add(beakTip);

        const eyeY = 0.01;
        const eyeZ = 0.185;
        const eyeX = 0.112;
        [-1, 1].forEach((side) => {
            const eyeRing = new THREE.Mesh(new THREE.TorusGeometry(0.058, 0.011, 14, 36), trimMat);
            eyeRing.position.set(side * eyeX, eyeY, eyeZ);
            eyeRing.rotation.y = side * 0.12;
            group.add(eyeRing);

            const lens = new THREE.Mesh(new THREE.CylinderGeometry(0.046, 0.046, 0.012, 24), lensMat);
            lens.position.set(side * eyeX, eyeY, eyeZ + 0.002);
            lens.rotation.y = side * 0.12;
            group.add(lens);
        });

        const cheekBand = new THREE.Mesh(new THREE.TorusGeometry(0.214, 0.009, 10, 44, Math.PI * 0.96), trimMat);
        cheekBand.rotation.set(Math.PI / 2, 0, Math.PI);
        cheekBand.position.set(0, -0.025, -0.01);
        group.add(cheekBand);

        const sideStrapGeo = new THREE.BoxGeometry(0.06, 0.022, 0.36);
        const leftStrap = new THREE.Mesh(sideStrapGeo, leatherMat);
        leftStrap.position.set(-0.19, -0.02, -0.06);
        leftStrap.rotation.y = -0.16;
        group.add(leftStrap);

        const rightStrap = leftStrap.clone();
        rightStrap.position.x = 0.19;
        rightStrap.rotation.y = 0.16;
        group.add(rightStrap);

        const topStrap = new THREE.Mesh(new THREE.BoxGeometry(0.045, 0.02, 0.36), leatherMat);
        topStrap.position.set(0, 0.14, -0.01);
        topStrap.rotation.x = -0.12;
        group.add(topStrap);

        for (let i = 0; i < 9; i++) {
            const rivet = new THREE.Mesh(new THREE.SphereGeometry(0.0085, 10, 8), trimMat);
            const t = i / 8;
            rivet.position.set(0, 0.05 - t * 0.24, 0.175 + t * 0.27);
            rivet.position.x += Math.sin(t * Math.PI) * 0.004;
            group.add(rivet);
        }

        group.position.set(0, -0.03, 0.04);
        group.rotation.x = 0.06;
        return group;
    }
}
