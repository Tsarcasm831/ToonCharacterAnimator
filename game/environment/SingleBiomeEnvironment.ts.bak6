import * as THREE from 'three';
import { PlayerConfig } from '../../types';
import { calculateBounds, isPointInPolygon, landCoordsToWorld, LAND_SCALE } from './landTerrain';
import { LightingManager } from './LightingManager';
import { WorldGridManager } from './WorldGridManager';
import { ObjectFactory } from './ObjectFactory';
import { PlayerUtils } from '../player/PlayerUtils';
import { HiveMindController } from '../entities/swarm/HiveMindController';
import { DebrisSystem } from './DebrisSystem';
import { TreeData } from './EnvironmentTypes';

interface RockFormationData {
    id: string;
    group: THREE.Object3D;
    obstacle: THREE.Object3D;
    health: number;
    shudderTimer: number;
    basePosition: THREE.Vector3;
}

interface MudClumpData {
    id: string;
    group: THREE.Object3D;
    obstacle: THREE.Object3D;
    health: number;
    shudderTimer: number;
    basePosition: THREE.Vector3;
}

export class SingleBiomeEnvironment {
    public group: THREE.Group;
    private scene: THREE.Scene;
    private mesh: THREE.Mesh | null = null;
    private pondWaterMeshes: THREE.Mesh[] = [];
    public obstacles: THREE.Object3D[] = [];
    private landPoints: number[][] | null = null;
    private lightingManager: LightingManager;
    private worldGrid: WorldGridManager;
    private debrisSystem: DebrisSystem;
    private trees: Map<string, TreeData> = new Map();
    private looseLogs: THREE.Mesh[] = [];
    private rockFormations: Map<string, RockFormationData> = new Map();
    private mudClumps: Map<string, MudClumpData> = new Map();
    private mudGroundPatches: THREE.Object3D[] = [];
    private pickupObjects: THREE.Object3D[] = [];
    private grassTuftMesh: THREE.InstancedMesh | null = null;
    private circularWallGroups: THREE.Object3D[] = [];
    private circularWallCenters: THREE.Vector2[] = [];
    private currentBiome: { name: string, color: string, type: string } = { name: 'Grass', color: '#4ade80', type: 'Grass' };
    private static readonly TREE_COUNT = 64;
    private static readonly TREE_HEALTH = 6;
    private static readonly ROCK_FORMATION_COUNT = 26;
    private static readonly ROCK_HEALTH = 6;
    private static readonly DEFAULT_ROCK_STONE_YIELD = 5;
    private static readonly MUD_CLUMP_COUNT = 36;
    private static readonly MUD_CLUMP_HEALTH = 6;
    private static readonly PICKUP_SCATTER_COUNT = 120;
    private static readonly GRASS_TUFT_COUNT = 2600;
    private static readonly SPAWN_ATTEMPT_MULTIPLIER = 10;
    private static readonly LOG_PICKUP_RANGE = 2.2;
    private static readonly PONDS = [
        { x: 8, z: 6, radius: 4.5, depth: 1.8 },
        { x: -22, z: -14, radius: 5.2, depth: 1.5 },
        { x: 26, z: -10, radius: 4.2, depth: 1.4 }
    ];
    private readonly terrainRaycaster = new THREE.Raycaster();
    private readonly terrainRayOrigin = new THREE.Vector3();
    private readonly terrainRayDirection = new THREE.Vector3(0, -1, 0);

    public hiveController: HiveMindController | null = null;
    public onLogPickedUp?: () => void;
    public getStoneDropCount?: () => number;
    public onAddToInventory?: (itemName: string, count: number) => void;
    public onOreCrumbling?: () => void;
    public onMudDug?: () => void;
    public onWrongTool?: (message: string) => void;
    public onTreeFall?: () => void;

    constructor(scene: THREE.Scene) {
        this.scene = scene;
        this.group = new THREE.Group();
        this.scene.add(this.group);
        this.lightingManager = new LightingManager(scene);
        this.lightingManager.setShadowCoverage(95);
        this.worldGrid = new WorldGridManager(this.group, {
            bounds: {
                minX: -100,
                maxX: 100,
                minZ: -100,
                maxZ: 100
            }
        });
        this.debrisSystem = new DebrisSystem(this.group, (logs) => {
            this.looseLogs.push(...logs);
        });
    }

    public syncSkySphereToLand(points?: number[][]) {
        const landPoints = points ?? this.landPoints;
        if (!landPoints) return;
        const bounds = calculateBounds(landPoints);
        const worldWidth = bounds.worldMaxX - bounds.worldMinX;
        const worldDepth = bounds.worldMaxZ - bounds.worldMinZ;
        this.updateSkySphereForBounds(worldWidth, worldDepth);
    }

    public setLandData(points: number[][], biome?: { name: string, color: string, type?: string }, options: { spawnHive?: boolean } = {}) {
        console.log(`[SingleBiomeEnvironment] setLandData called. Points: ${points?.length}, Biome: ${biome?.name}`);
        this.landPoints = points;
        if (biome) {
            this.currentBiome = {
                name: biome.name,
                color: biome.color,
                type: biome.type || 'Grass'
            };
        }
        
        // Ensure group is visible when building
        this.group.visible = true;
        this.build();

        if (this.hiveController) {
            this.hiveController.dispose();
            this.hiveController = null;
        }
        if (options.spawnHive !== false) {
            // Spawn slightly offset from center/player
            this.hiveController = new HiveMindController(this.scene, new THREE.Vector3(10, 3, 10), 50);
        }
    }

    public setVisible(visible: boolean) {
        this.group.visible = visible;
        if (!visible) {
             // We might want to handle lighting visibility too, but LightingManager adds to scene root
             // Usually LightingManager handles its own cleanup or we can hide lights
        }
    }

    public dispose() {
        if (this.scene && this.group) {
            this.scene.remove(this.group);
        }

        if (this.hiveController) {
            this.hiveController.dispose();
            this.hiveController = null;
        }

        this.clearPonds();

        this.group.traverse((child) => {
            if (child instanceof THREE.Mesh) {
                child.geometry.dispose();
                if (Array.isArray(child.material)) {
                    child.material.forEach(m => m.dispose());
                } else {
                    child.material.dispose();
                }
            }
        });

        if (this.mesh) {
            this.mesh = null;
        }
        this.obstacles = [];
        this.debrisSystem.dispose();
        this.trees.clear();
        this.looseLogs = [];
        this.rockFormations.clear();
        this.pickupObjects = [];
        this.disposeGrassTufts();
        this.lightingManager.dispose();
        this.worldGrid.dispose();
        PlayerUtils.setCustomLandPolygon(null); // Clear constraint
        PlayerUtils.setCustomTerrainSamplers(null);
    }

    private build() {
        console.log(`[SingleBiomeEnvironment] Building... Points: ${this.landPoints?.length}`);
        if (!this.landPoints) return;

        // Dispose existing mesh if any
        if (this.mesh) {
            this.clearDynamicObjects();
            this.clearPonds();
            this.group.remove(this.mesh);
            this.mesh.geometry.dispose();
            if (Array.isArray(this.mesh.material)) {
                this.mesh.material.forEach(m => m.dispose());
            } else {
                this.mesh.material.dispose();
            }
            this.mesh = null;
            this.obstacles = [];
        }

        const bounds = calculateBounds(this.landPoints);
        const { worldMinX, worldMaxX, worldMinZ, worldMaxZ, centerX, centerZ } = bounds;
        const worldWidth = worldMaxX - worldMinX;
        const worldDepth = worldMaxZ - worldMinZ;
        this.updateSkySphereForBounds(worldWidth, worldDepth);

        // Convert raw land points to world space for the polygon check
        const worldPoints = this.landPoints.map(p => {
            const w = landCoordsToWorld(p[0], p[1], centerX, centerZ);
            return [w.x, w.z];
        });

        // Set player constraint
        PlayerUtils.setCustomLandPolygon(worldPoints);

        // Build a terrain mesh that only includes triangles fully inside the land polygon.
        const step = 4;
        const segmentsX = Math.max(1, Math.floor(worldWidth / step));
        const segmentsZ = Math.max(1, Math.floor(worldDepth / step));
        const vertsX = segmentsX + 1;
        const vertsZ = segmentsZ + 1;
        const totalVerts = vertsX * vertsZ;

        const positions = new Float32Array(totalVerts * 3);
        const uvs = new Float32Array(totalVerts * 2);
        const inside = new Array<boolean>(totalVerts);

        const startX = worldMinX;
        const startZ = worldMinZ;

        let v = 0;
        for (let z = 0; z < vertsZ; z += 1) {
            const zPos = startZ + z * step;
            for (let x = 0; x < vertsX; x += 1) {
                const xPos = startX + x * step;
                const yPos = this.getTerrainHeightAt(xPos, zPos);
                
                const idx = v * 3;
                positions[idx] = xPos;
                positions[idx + 1] = yPos;
                positions[idx + 2] = zPos;

                const uvIdx = v * 2;
                uvs[uvIdx] = x / segmentsX;
                uvs[uvIdx + 1] = 1 - z / segmentsZ;

                // Use the world space points for the check
                inside[v] = isPointInPolygon(xPos, zPos, worldPoints);
                v += 1;
            }
        }

        const indices: number[] = [];
        for (let z = 0; z < segmentsZ; z += 1) {
            for (let x = 0; x < segmentsX; x += 1) {
                const a = x + z * vertsX;
                const b = x + (z + 1) * vertsX;
                const c = (x + 1) + (z + 1) * vertsX;
                const d = (x + 1) + z * vertsX;

                if (inside[a] && inside[b] && inside[c] && inside[d]) {
                    indices.push(a, b, d);
                    indices.push(b, c, d);
                }
            }
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('uv', new THREE.BufferAttribute(uvs, 2));
        geometry.setIndex(indices);
        geometry.computeVertexNormals();
        geometry.computeBoundingBox();
        geometry.computeBoundingSphere();

        // Material - Based on biome with programmatic texture
        const texture = this.createGrassTexture(this.currentBiome.color);
        const material = new THREE.MeshStandardMaterial({
            color: new THREE.Color(this.currentBiome.color),
            map: texture,
            roughness: 0.85,
            metalness: 0.05,
            side: THREE.FrontSide
        });

        this.mesh = new THREE.Mesh(geometry, material);
        this.mesh.receiveShadow = true;
        this.mesh.castShadow = false;
        this.mesh.userData = { type: 'ground', terrainType: this.currentBiome.type };
        
        this.group.add(this.mesh);
        this.obstacles.push(this.mesh);
        this.buildPonds();

        PlayerUtils.setCustomTerrainSamplers(
            (x, z) => this.getTerrainHeightAt(x, z),
            (x, z) => this.getWaterDepthAt(x, z)
        );

        // Spawn trees within the land polygon
        this.spawnTrees(worldPoints, bounds);
        this.spawnRockFormations(worldPoints, bounds);
        this.spawnMudClumps(worldPoints, bounds);
        this.spawnPickupScatter(worldPoints, bounds);
        this.spawnGrassTufts(worldPoints, bounds);

        if (this.circularWallCenters.length > 0) {
            this.clearCircularWalls();
            this.circularWallCenters.forEach(center => this.addCircularWall(center, 2));
        }
    }

    private updateSkySphereForBounds(worldWidth: number, worldDepth: number) {
        const halfWidth = worldWidth * 0.5;
        const halfDepth = worldDepth * 0.5;
        const landRadius = Math.sqrt((halfWidth * halfWidth) + (halfDepth * halfDepth));
        const skyRadius = landRadius * 1.2;
        this.lightingManager.setSkySphereRadius(skyRadius);
        const shadowCoverage = THREE.MathUtils.clamp(landRadius * 0.45, 80, 150);
        this.lightingManager.setShadowCoverage(shadowCoverage);
    }

    private getBaseTerrainHeightAt(x: number, z: number): number {
        const broadHill = Math.sin(x * 0.032) * 0.82 + Math.cos(z * 0.03) * 0.68;
        const crossHill = Math.sin((x + z) * 0.021) * 0.48;
        const diagonalRoll = Math.cos((x - z) * 0.026 + 0.8) * 0.38;
        const fineRoll = Math.sin(x * 0.082 + 1.7) * Math.cos(z * 0.072 - 0.4) * 0.28;
        return broadHill + crossHill + diagonalRoll + fineRoll;
    }

    private getTerrainHeightAt(x: number, z: number): number {
        let height = this.getBaseTerrainHeightAt(x, z);

        for (const pond of SingleBiomeEnvironment.PONDS) {
            const dx = x - pond.x;
            const dz = z - pond.z;
            const dist = Math.sqrt(dx * dx + dz * dz);
            if (dist >= pond.radius) continue;

            const normalized = dist / pond.radius;
            const smoothBasin = (1 - normalized * normalized);
            const rimBlend = smoothBasin * smoothBasin;
            height -= pond.depth * rimBlend;
        }

        return height;
    }

    private getPondWaterSurfaceY(pond: { x: number; z: number; radius: number; depth: number }): number {
        return this.getBaseTerrainHeightAt(pond.x, pond.z) - Math.min(0.34, pond.depth * 0.24);
    }

    private getWaterDepthAt(x: number, z: number): number {
        let waterDepth = 0;

        for (const pond of SingleBiomeEnvironment.PONDS) {
            const dx = x - pond.x;
            const dz = z - pond.z;
            const dist = Math.sqrt(dx * dx + dz * dz);
            if (dist >= pond.radius) continue;

            const terrainY = this.getTerrainHeightAt(x, z);
            const surfaceY = this.getPondWaterSurfaceY(pond);
            waterDepth = Math.max(waterDepth, surfaceY - terrainY);
        }

        return Math.max(0, waterDepth);
    }

    private buildPonds() {
        this.clearPonds();

        for (const pond of SingleBiomeEnvironment.PONDS) {
            const waterRadius = pond.radius * 0.86;
            const waterGeometry = new THREE.CircleGeometry(waterRadius, 48);
            const waterMaterial = new THREE.MeshPhysicalMaterial({
                color: 0x2d9be8,
                roughness: 0.18,
                metalness: 0.0,
                transparent: true,
                opacity: 0.62,
                transmission: 0.15,
                side: THREE.DoubleSide,
                depthWrite: false
            });
            const water = new THREE.Mesh(waterGeometry, waterMaterial);
            water.rotation.x = -Math.PI / 2;
            water.position.set(pond.x, this.getPondWaterSurfaceY(pond) + 0.025, pond.z);
            water.receiveShadow = false;
            water.name = 'starter_pond_water';
            this.group.add(water);
            this.pondWaterMeshes.push(water);
        }
    }

    private clearPonds() {
        this.pondWaterMeshes.forEach(water => {
            this.group.remove(water);
            water.geometry.dispose();
            if (Array.isArray(water.material)) {
                water.material.forEach(material => material.dispose());
            } else {
                water.material.dispose();
            }
        });
        this.pondWaterMeshes = [];
    }

    update(dt: number, config: PlayerConfig, playerPos: THREE.Vector3) {
        if (!this.group.visible) return;
        this.debrisSystem.update(dt);
        this.lightingManager.update(dt, config, playerPos);
        this.worldGrid.update(playerPos);
        if (this.hiveController) {
            this.hiveController.update(dt, playerPos);
        }
        this.collectNearbyLogs(playerPos);

        this.trees.forEach(tree => {
            if (tree.shudderTimer > 0) {
                tree.shudderTimer -= dt;
                const offset = Math.sin(tree.shudderTimer * 50) * 0.05;
                tree.group.position.x = tree.basePosition.x + offset;
                if (tree.shudderTimer <= 0) {
                    tree.group.position.copy(tree.basePosition);
                }
            }
        });

        this.rockFormations.forEach(rock => {
            if (rock.shudderTimer > 0) {
                rock.shudderTimer -= dt;
                const offset = Math.sin(rock.shudderTimer * 60) * 0.035;
                rock.group.position.x = rock.basePosition.x + offset;
                if (rock.shudderTimer <= 0) {
                    rock.group.position.copy(rock.basePosition);
                }
            }
        });

        this.mudClumps.forEach(mudClump => {
            if (mudClump.shudderTimer > 0) {
                mudClump.shudderTimer -= dt;
                const offset = Math.sin(mudClump.shudderTimer * 50) * 0.04;
                mudClump.group.position.x = mudClump.basePosition.x + offset;
                if (mudClump.shudderTimer <= 0) {
                    mudClump.group.position.copy(mudClump.basePosition);
                }
            }
        });
    }

    // Interface methods for compatibility with Player/Game
    getBiomeAt(pos: THREE.Vector3): { name: string, color: string, type: string } {
        return this.currentBiome;
    }

    damageObstacle(obj: THREE.Object3D, amount: number, selectedItem?: string): string | null {
        const rock = this.rockFormations.get(obj.uuid);
        if (rock) {
            // Only allow pickaxe for rocks
            if (selectedItem !== 'Pickaxe') {
                this.onWrongTool?.('Use a Pickaxe to mine rocks');
                return null;
            }
            rock.health -= amount;
            rock.shudderTimer = 0.25;

            if (rock.health <= 0) {
                this.obstacles = this.obstacles.filter(obstacle => obstacle.uuid !== obj.uuid);
                this.rockFormations.delete(obj.uuid);
                this.group.remove(rock.group);
                this.spawnRockStoneDrops(rock.basePosition, this.getStoneDropCount?.() ?? SingleBiomeEnvironment.DEFAULT_ROCK_STONE_YIELD);
                this.onOreCrumbling?.();
            }

            return 'stone';
        }

        const mudClump = this.mudClumps.get(obj.uuid);
        if (mudClump) {
            // Only allow digging with shovel
            if (selectedItem !== 'Shovel') {
                this.onWrongTool?.('Use a Shovel to dig mud');
                return null;
            }
            mudClump.health -= amount;
            mudClump.shudderTimer = 0.25;

            if (mudClump.health <= 0) {
                this.obstacles = this.obstacles.filter(obstacle => obstacle.uuid !== obj.uuid);
                this.mudClumps.delete(obj.uuid);
                this.group.remove(mudClump.group);
                this.spawnMudDrops(mudClump.basePosition);
                this.onMudDug?.();
            }

            return 'mud';
        }

        const tree = this.trees.get(obj.uuid);
        if (!tree) {
            return null;
        }

        // Only allow axe for trees
        if (selectedItem !== 'Axe') {
            this.onWrongTool?.('Use an Axe to chop trees');
            return null;
        }

        tree.health -= amount;
        tree.shudderTimer = 0.3;

        if (tree.health <= 0) {
            this.obstacles = this.obstacles.filter(obstacle => obstacle.uuid !== obj.uuid);
            this.trees.delete(obj.uuid);

            const trunkMaterial = this.getTreeMaterial(tree);
            this.group.remove(tree.group);

            if (trunkMaterial) {
                const fallingGroup = ObjectFactory.createFallingTrunk(tree.basePosition, trunkMaterial);
                this.debrisSystem.addFallingTree(fallingGroup);

                const stump = ObjectFactory.createStump(tree.basePosition, tree.group.quaternion, trunkMaterial);
                this.group.add(stump);
                this.obstacles.push(stump);
            }

            // Play tree fall sound
            this.onTreeFall?.();

            // Drop sticks directly to inventory
            const stickDropCount = 8;
            if (this.onAddToInventory) {
                this.onAddToInventory('Stick', stickDropCount);
            }
        }

        return 'wood';
    }

    addObstacle(obj: THREE.Object3D) {
        this.group.add(obj);
        this.obstacles.push(obj);
    }
    
    toggleWorldGrid(visible?: boolean) {
        if (typeof visible === 'boolean') {
            this.worldGrid.setVisible(visible);
            return;
        }
        this.worldGrid.toggle();
    }

    public setCircularWallCenter(center: THREE.Vector2 | null) {
        this.setTownWallCenters(center ? [center] : []);
    }

    public setTownWallCenters(centers: THREE.Vector2[]) {
        this.circularWallCenters = centers;
        if (!this.mesh) return;
        this.clearCircularWalls();
        if (centers.length > 0) {
            centers.forEach(center => this.addCircularWall(center, 2));

            // Move Hive to the first wall
            if (this.hiveController) {
                // Wall is at center (x, z).
                // Place hive nearby (offset by 10 units)
                const wallPos = centers[0];
                // Use y=8 to be safe above ground (land is approx y=5)
                const spawnPos = new THREE.Vector3(wallPos.x + 10, 8, wallPos.y + 10);
                this.hiveController.teleport(spawnPos);
                console.log(`[SingleBiomeEnvironment] Hive teleported to wall at ${spawnPos.x}, ${spawnPos.y}, ${spawnPos.z}`);
            }
        }
    }

    private addCircularWall(center: THREE.Vector2, diameterInGrids: number) {
        const GRID_SIZE = 1.3333;
        const WALL_LENGTH = GRID_SIZE * 4;
        const wallScale = 0.5;
        const segmentCount = 8;
        const targetRadius = (diameterInGrids * GRID_SIZE) * 0.5;
        const segmentLength = WALL_LENGTH * wallScale;
        const minRadius = segmentLength / (2 * Math.sin(Math.PI / segmentCount));
        const radius = Math.max(targetRadius, minRadius);

        for (let i = 0; i < segmentCount; i += 1) {
            const angleA = (i / segmentCount) * Math.PI * 2;
            const angleB = ((i + 1) / segmentCount) * Math.PI * 2;
            const v1 = new THREE.Vector2(
                center.x + Math.cos(angleA) * radius,
                center.y + Math.sin(angleA) * radius
            );
            const v2 = new THREE.Vector2(
                center.x + Math.cos(angleB) * radius,
                center.y + Math.sin(angleB) * radius
            );
            const mid = v1.clone().add(v2).multiplyScalar(0.5);
            const dir = v2.clone().sub(v1);
            const rotation = Math.atan2(dir.y, dir.x) + Math.PI / 2;
            const y = this.raycastTerrainHeight(mid.x, mid.y);
            const { group, obstacle } = ObjectFactory.createWall(new THREE.Vector3(mid.x, y, mid.y), rotation);
            group.scale.setScalar(wallScale);
            this.group.add(group);
            this.obstacles.push(obstacle);
            this.circularWallGroups.push(group);
        }
    }

    private clearCircularWalls() {
        this.circularWallGroups.forEach(group => {
            this.group.remove(group);
            group.traverse(child => {
                if (child instanceof THREE.Mesh) {
                    child.geometry.dispose();
                    if (Array.isArray(child.material)) {
                        child.material.forEach(m => m.dispose());
                    } else {
                        child.material.dispose();
                    }
                }
            });
        });
        this.circularWallGroups = [];
    }

    private clearDynamicObjects() {
        this.trees.forEach(tree => {
            this.group.remove(tree.group);
        });
        this.trees.clear();

        this.rockFormations.forEach(formation => {
            this.group.remove(formation.group);
        });
        this.rockFormations.clear();

        this.mudClumps.forEach(mud => {
            this.group.remove(mud.group);
        });
        this.mudClumps.clear();

        this.mudGroundPatches.forEach(patch => {
            this.group.remove(patch);
        });
        this.mudGroundPatches = [];

        this.pickupObjects.forEach(pickup => {
            this.group.remove(pickup);
        });
        this.pickupObjects = [];

        this.looseLogs.forEach(log => {
            this.group.remove(log);
        });
        this.looseLogs = [];
        this.debrisSystem.dispose();
        this.disposeGrassTufts();
    }

    private collectNearbyLogs(playerPos: THREE.Vector3) {
        const pickupRangeSq = SingleBiomeEnvironment.LOG_PICKUP_RANGE * SingleBiomeEnvironment.LOG_PICKUP_RANGE;

        for (let i = this.looseLogs.length - 1; i >= 0; i -= 1) {
            const log = this.looseLogs[i];
            if (!log.parent) {
                this.looseLogs.splice(i, 1);
                continue;
            }

            const dx = log.position.x - playerPos.x;
            const dz = log.position.z - playerPos.z;
            if ((dx * dx + dz * dz) > pickupRangeSq) continue;

            this.group.remove(log);
            this.looseLogs.splice(i, 1);
            this.onLogPickedUp?.();
        }
    }

    private getTreeMaterial(tree: TreeData): THREE.Material | null {
        const trunkMesh = tree.trunk.children.find(child => child instanceof THREE.Mesh) as THREE.Mesh | undefined;
        const material = trunkMesh?.material;
        if (Array.isArray(material)) return material[0] ?? null;
        return material ?? null;
    }

    private getRandomPointInLand(worldPoints: number[][], bounds: ReturnType<typeof calculateBounds>): THREE.Vector3 | null {
        const { worldMinX, worldMaxX, worldMinZ, worldMaxZ } = bounds;
        const x = worldMinX + Math.random() * (worldMaxX - worldMinX);
        const z = worldMinZ + Math.random() * (worldMaxZ - worldMinZ);
        if (!isPointInPolygon(x, z, worldPoints)) return null;
        if (!PlayerUtils.isWithinBounds(new THREE.Vector3(x, 0, z), 3.0)) return null;
        if (this.getWaterDepthAt(x, z) > 0.05) return null;

        return new THREE.Vector3(x, this.raycastTerrainHeight(x, z), z);
    }

    private raycastTerrainHeight(x: number, z: number): number {
        if (!this.mesh) return this.getTerrainHeightAt(x, z);

        this.terrainRayOrigin.set(x, 120, z);
        this.terrainRaycaster.set(this.terrainRayOrigin, this.terrainRayDirection);
        this.terrainRaycaster.far = 260;
        const hits = this.terrainRaycaster.intersectObject(this.mesh, false);
        return hits[0]?.point.y ?? this.getTerrainHeightAt(x, z);
    }

    private prepareDenseStaticObject(object: THREE.Object3D, castShadows: boolean, receiveShadows: boolean = false) {
        object.traverse(child => {
            if (child instanceof THREE.Mesh) {
                child.castShadow = castShadows;
                child.receiveShadow = receiveShadows;
                child.frustumCulled = true;
                child.updateMatrix();
                child.matrixAutoUpdate = false;
            }
        });
    }

    private spawnTrees(worldPoints: number[][], bounds: ReturnType<typeof calculateBounds>) {
        let spawned = 0;
        const maxAttempts = SingleBiomeEnvironment.TREE_COUNT * SingleBiomeEnvironment.SPAWN_ATTEMPT_MULTIPLIER;

        for (let attempt = 0; attempt < maxAttempts && spawned < SingleBiomeEnvironment.TREE_COUNT; attempt++) {
            const pos = this.getRandomPointInLand(worldPoints, bounds);
            if (!pos) continue;

            // Create tree based on biome type
            const result = this.currentBiome.type === 'snow'
                ? ObjectFactory.createPineTree(pos, 1.2 + Math.random() * 0.8)
                : ObjectFactory.createTree(pos);

            if (result && result.group && result.trunk) {
                const leaves = 'leaves' in result ? result.leaves : undefined;
                this.prepareDenseStaticObject(result.group, true);
                this.group.add(result.group);
                this.obstacles.push(result.trunk);
                this.trees.set(result.trunk.uuid, {
                    id: result.trunk.uuid,
                    group: result.group,
                    trunk: result.trunk,
                    leaves: leaves ?? undefined as any,
                    health: SingleBiomeEnvironment.TREE_HEALTH,
                    shudderTimer: 0,
                    basePosition: result.group.position.clone()
                });
                spawned += 1;
            }
        }
    }

    private spawnRockFormations(worldPoints: number[][], bounds: ReturnType<typeof calculateBounds>) {
        let spawned = 0;
        const maxAttempts = SingleBiomeEnvironment.ROCK_FORMATION_COUNT * SingleBiomeEnvironment.SPAWN_ATTEMPT_MULTIPLIER;

        for (let attempt = 0; attempt < maxAttempts && spawned < SingleBiomeEnvironment.ROCK_FORMATION_COUNT; attempt++) {
            const pos = this.getRandomPointInLand(worldPoints, bounds);
            if (!pos) continue;

            const scale = 0.9 + Math.random() * 0.18;
            const result = ObjectFactory.createRockFormation(pos, scale);

            if (result && result.group && result.obstacle) {
                this.prepareDenseStaticObject(result.group, true, true);
                this.group.add(result.group);
                this.obstacles.push(result.obstacle);
                this.rockFormations.set(result.obstacle.uuid, {
                    id: result.obstacle.uuid,
                    group: result.group,
                    obstacle: result.obstacle,
                    health: SingleBiomeEnvironment.ROCK_HEALTH,
                    shudderTimer: 0,
                    basePosition: result.group.position.clone()
                });
                spawned += 1;
            }
        }
    }

    private spawnMudClumps(worldPoints: number[][], bounds: ReturnType<typeof calculateBounds>) {
        let spawned = 0;
        const maxAttempts = SingleBiomeEnvironment.MUD_CLUMP_COUNT * SingleBiomeEnvironment.SPAWN_ATTEMPT_MULTIPLIER;

        for (let attempt = 0; attempt < maxAttempts && spawned < SingleBiomeEnvironment.MUD_CLUMP_COUNT; attempt++) {
            const pos = this.getRandomPointInLand(worldPoints, bounds);
            if (!pos) continue;

            const scale = 0.8 + Math.random() * 0.4;
            const result = ObjectFactory.createMudClump(pos, scale);

            if (result && result.group && result.obstacle) {
                const groundPatch = this.createMudGroundPatch(pos, scale);
                this.prepareDenseStaticObject(groundPatch, false, true);
                this.group.add(groundPatch);
                this.mudGroundPatches.push(groundPatch);

                this.prepareDenseStaticObject(result.group, true, true);
                this.group.add(result.group);
                this.obstacles.push(result.obstacle);
                this.mudClumps.set(result.obstacle.uuid, {
                    id: result.obstacle.uuid,
                    group: result.group,
                    obstacle: result.obstacle,
                    health: SingleBiomeEnvironment.MUD_CLUMP_HEALTH,
                    shudderTimer: 0,
                    basePosition: result.group.position.clone()
                });
                spawned += 1;
            }
        }
    }

    private createMudGroundPatch(position: THREE.Vector3, scale: number) {
        const group = new THREE.Group();
        group.position.copy(position);
        group.position.y += 0.018;
        group.rotation.y = Math.random() * Math.PI * 2;

        const wetMud = new THREE.MeshStandardMaterial({
            color: 0x2b1a12,
            roughness: 0.72,
            metalness: 0.0,
            polygonOffset: true,
            polygonOffsetFactor: -1,
            polygonOffsetUnits: -1
        });
        const rimMud = new THREE.MeshStandardMaterial({
            color: 0x6b4a32,
            roughness: 0.95,
            metalness: 0.0,
            flatShading: true
        });

        const depression = new THREE.Mesh(
            new THREE.CylinderGeometry(1.45 * scale, 1.25 * scale, 0.025, 24),
            wetMud
        );
        depression.scale.set(1.15, 1, 0.62);
        depression.receiveShadow = true;
        group.add(depression);

        const rimGeo = new THREE.DodecahedronGeometry(0.16 * scale, 0);
        for (let i = 0; i < 14; i += 1) {
            const angle = (i / 14) * Math.PI * 2 + Math.random() * 0.18;
            const radiusX = 1.25 * scale + Math.random() * 0.22;
            const radiusZ = 0.72 * scale + Math.random() * 0.12;
            const clod = new THREE.Mesh(rimGeo, rimMud);
            clod.position.set(Math.cos(angle) * radiusX, 0.035, Math.sin(angle) * radiusZ);
            clod.scale.set(1.2 + Math.random() * 0.7, 0.22 + Math.random() * 0.16, 0.75 + Math.random() * 0.45);
            clod.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
            clod.castShadow = true;
            clod.receiveShadow = true;
            group.add(clod);
        }

        return group;
    }

    private spawnPickupScatter(worldPoints: number[][], bounds: ReturnType<typeof calculateBounds>) {
        let spawned = 0;
        const maxAttempts = SingleBiomeEnvironment.PICKUP_SCATTER_COUNT * SingleBiomeEnvironment.SPAWN_ATTEMPT_MULTIPLIER;

        for (let attempt = 0; attempt < maxAttempts && spawned < SingleBiomeEnvironment.PICKUP_SCATTER_COUNT; attempt++) {
            const pos = this.getRandomPointInLand(worldPoints, bounds);
            if (!pos) continue;

            const pickup = spawned % 2 === 0
                ? ObjectFactory.createPickupStick(pos)
                : ObjectFactory.createPickupRock(pos);

            this.addPickupObject(pickup);
            spawned += 1;
        }
    }

    private spawnRockStoneDrops(center: THREE.Vector3, count: number) {
        const dropCount = Math.max(0, Math.floor(count));
        if (this.onAddToInventory) {
            this.onAddToInventory('Stone', dropCount);
        }
    }

    private spawnMudDrops(center: THREE.Vector3) {
        if (this.onAddToInventory) {
            this.onAddToInventory('Mud', 2);
        }
    }

    public spawnItemDrop(itemName: string, count: number, position: THREE.Vector3) {
        const dropCount = Math.max(1, Math.floor(count));
        const group = new THREE.Group();
        const dropPos = position.clone();
        dropPos.y = this.raycastTerrainHeight(dropPos.x, dropPos.z) + 0.08;
        group.position.copy(dropPos);
        group.rotation.y = Math.random() * Math.PI * 2;

        const color = itemName === 'Porkchop'
            ? 0xb83a3a
            : itemName === 'Leather'
                ? 0x8a5a2b
                : itemName === 'Bone Fragments'
                    ? 0xd8d0bd
                    : 0xf5f5f5;
        const material = new THREE.MeshStandardMaterial({ color, roughness: 0.82 });
        const geometry = itemName === 'Bone Fragments'
            ? new THREE.BoxGeometry(0.16, 0.08, 0.36)
            : new THREE.BoxGeometry(0.34, 0.12, 0.28);

        const visiblePieces = Math.min(3, dropCount);
        for (let i = 0; i < visiblePieces; i += 1) {
            const mesh = new THREE.Mesh(geometry, material);
            mesh.position.set((Math.random() - 0.5) * 0.28, 0.08 + i * 0.025, (Math.random() - 0.5) * 0.28);
            mesh.rotation.set(Math.random() * 0.35, Math.random() * Math.PI, Math.random() * 0.35);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            group.add(mesh);
        }

        group.userData = {
            type: 'pickup',
            pickupItem: itemName,
            pickupCount: dropCount,
            interactionLabel: `Press F to Pick Up ${itemName}`
        };

        this.addPickupObject(group);
    }

    private spawnGrassTufts(worldPoints: number[][], bounds: ReturnType<typeof calculateBounds>) {
        this.disposeGrassTufts();

        const geometry = this.createGrassTuftGeometry();
        const material = new THREE.MeshStandardMaterial({
            color: 0xffffff,
            roughness: 0.92,
            flatShading: true,
            side: THREE.DoubleSide,
            vertexColors: true
        });
        const mesh = new THREE.InstancedMesh(geometry, material, SingleBiomeEnvironment.GRASS_TUFT_COUNT);
        mesh.instanceMatrix.setUsage(THREE.StaticDrawUsage);
        mesh.castShadow = false;
        mesh.receiveShadow = false;
        mesh.frustumCulled = false;

        const dummy = new THREE.Object3D();
        const color = new THREE.Color();
        let spawned = 0;
        const maxAttempts = SingleBiomeEnvironment.GRASS_TUFT_COUNT * SingleBiomeEnvironment.SPAWN_ATTEMPT_MULTIPLIER;

        for (let attempt = 0; attempt < maxAttempts && spawned < SingleBiomeEnvironment.GRASS_TUFT_COUNT; attempt += 1) {
            const pos = this.getRandomPointInLand(worldPoints, bounds);
            if (!pos) continue;

            dummy.position.copy(pos);
            dummy.rotation.set(0, Math.random() * Math.PI * 2, 0);
            const width = 0.75 + Math.random() * 0.8;
            const height = 0.65 + Math.random() * 0.7;
            dummy.scale.set(width, height, width);
            dummy.updateMatrix();
            mesh.setMatrixAt(spawned, dummy.matrix);

            color.setHSL(0.29 + (Math.random() - 0.5) * 0.045, 0.42 + Math.random() * 0.28, 0.32 + Math.random() * 0.16);
            mesh.setColorAt(spawned, color);
            spawned += 1;
        }

        mesh.count = spawned;
        mesh.instanceMatrix.needsUpdate = true;
        if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
        this.group.add(mesh);
        this.grassTuftMesh = mesh;
    }

    private createGrassTexture(baseColor: string): THREE.CanvasTexture {
        const size = 512;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        if (!ctx) {
            return new THREE.CanvasTexture(canvas);
        }

        const baseColorRGB = this.hexToRgb(baseColor);
        const r = baseColorRGB.r;
        const g = baseColorRGB.g;
        const b = baseColorRGB.b;

        // Fill base color
        ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
        ctx.fillRect(0, 0, size, size);

        // Add noise for texture detail
        const imageData = ctx.getImageData(0, 0, size, size);
        const data = imageData.data;

        for (let i = 0; i < data.length; i += 4) {
            const noise = (Math.random() - 0.5) * 30;
            data[i] = Math.max(0, Math.min(255, data[i] + noise));
            data[i + 1] = Math.max(0, Math.min(255, data[i + 1] + noise));
            data[i + 2] = Math.max(0, Math.min(255, data[i + 2] + noise));
        }
        ctx.putImageData(imageData, 0, 0);

        // Add grass blade patterns
        for (let i = 0; i < 4000; i++) {
            const x = Math.random() * size;
            const y = Math.random() * size;
            const length = 3 + Math.random() * 8;
            const angle = Math.random() * Math.PI * 2;
            const brightness = 0.7 + Math.random() * 0.3;

            ctx.strokeStyle = `rgba(${Math.floor(r * brightness)}, ${Math.floor(g * brightness)}, ${Math.floor(b * brightness)}, 0.3)`;
            ctx.lineWidth = 1 + Math.random() * 1.5;
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(x + Math.cos(angle) * length, y + Math.sin(angle) * length);
            ctx.stroke();
        }

        // Add subtle dirt patches
        for (let i = 0; i < 150; i++) {
            const x = Math.random() * size;
            const y = Math.random() * size;
            const radius = 5 + Math.random() * 15;
            const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
            gradient.addColorStop(0, 'rgba(101, 67, 33, 0.15)');
            gradient.addColorStop(1, 'rgba(101, 67, 33, 0)');
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
        }

        // Add subtle variation patches
        for (let i = 0; i < 80; i++) {
            const x = Math.random() * size;
            const y = Math.random() * size;
            const radius = 10 + Math.random() * 30;
            const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
            const brightness = 0.9 + Math.random() * 0.2;
            gradient.addColorStop(0, `rgba(${Math.floor(r * brightness)}, ${Math.floor(g * brightness)}, ${Math.floor(b * brightness)}, 0.2)`);
            gradient.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fill();
        }

        const texture = new THREE.CanvasTexture(canvas);
        texture.wrapS = THREE.RepeatWrapping;
        texture.wrapT = THREE.RepeatWrapping;
        texture.repeat.set(4, 4);
        texture.anisotropy = 16;

        return texture;
    }

    private hexToRgb(hex: string): { r: number; g: number; b: number } {
        const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return result
            ? {
                r: parseInt(result[1], 16),
                g: parseInt(result[2], 16),
                b: parseInt(result[3], 16),
            }
            : { r: 74, g: 222, b: 128 };
    }

    private createGrassTuftGeometry(): THREE.BufferGeometry {
        const positions: number[] = [];
        const bladeCount = 6;

        for (let i = 0; i < bladeCount; i += 1) {
            const angle = (i / bladeCount) * Math.PI * 2;
            const rootRadius = i % 2 === 0 ? 0.03 : 0.075;
            const halfWidth = 0.035 + (i % 3) * 0.008;
            const height = 0.22 + (i % 4) * 0.035;
            const lean = 0.045 + (i % 2) * 0.035;
            const cos = Math.cos(angle);
            const sin = Math.sin(angle);
            const rightX = Math.cos(angle + Math.PI * 0.5) * halfWidth;
            const rightZ = Math.sin(angle + Math.PI * 0.5) * halfWidth;
            const rootX = cos * rootRadius;
            const rootZ = sin * rootRadius;
            const tipX = rootX + cos * lean;
            const tipZ = rootZ + sin * lean;

            positions.push(
                rootX - rightX, 0, rootZ - rightZ,
                rootX + rightX, 0, rootZ + rightZ,
                tipX, height, tipZ
            );
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.computeVertexNormals();
        geometry.computeBoundingSphere();
        return geometry;
    }

    private disposeGrassTufts() {
        if (!this.grassTuftMesh) return;
        this.group.remove(this.grassTuftMesh);
        this.grassTuftMesh.geometry.dispose();
        if (Array.isArray(this.grassTuftMesh.material)) {
            this.grassTuftMesh.material.forEach(material => material.dispose());
        } else {
            this.grassTuftMesh.material.dispose();
        }
        this.grassTuftMesh = null;
    }

    private addPickupObject(pickup: THREE.Object3D) {
        this.prepareDenseStaticObject(pickup, false);
        pickup.userData.onPickup = () => {
            this.group.remove(pickup);
            this.obstacles = this.obstacles.filter(obstacle => obstacle.uuid !== pickup.uuid);
            this.pickupObjects = this.pickupObjects.filter(obj => obj.uuid !== pickup.uuid);
        };

        this.group.add(pickup);
        this.obstacles.push(pickup);
        this.pickupObjects.push(pickup);
    }
}
