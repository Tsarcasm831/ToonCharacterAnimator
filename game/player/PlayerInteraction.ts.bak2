import * as THREE from 'three';
import type { Player } from './Player';
import { PlayerInput } from '../../types';
import { LowLevelCityGuard } from '../entities/npc/friendly/LowLevelCityGuard';
import { Blacksmith } from '../entities/npc/friendly/Blacksmith';
// Standardized to lowercase npc folder
import { Shopkeeper } from '../entities/npc/friendly/Shopkeeper';

export class PlayerInteraction {

    static update(player: Player, dt: number, input: PlayerInput, obstacles: THREE.Object3D[], entities: any[] = []) {
        // Picking Up
        if (player.isPickingUp) {
            player.pickUpTime += dt;
            if (player.pickUpTime > 1.2) { 
                player.isPickingUp = false; 
                player.pickUpTime = 0; 
            }
        }

        // Skinning Check & Logic
        const hasKnife = player.config.selectedItem === 'Knife';
        const skinnableTarget = this.getSkinnableTargetNearby(player, obstacles);
        player.canSkin = !!skinnableTarget && hasKnife;

        // Generic Interaction Check (Forge, Door, etc.)
        const interactableTarget = this.getInteractableTargetNearby(player, obstacles);
        // Set the interactable target on the player
        player.interactableTarget = interactableTarget;

        const pickupTarget = this.getPickupTargetNearby(player, obstacles);
        player.pickupTarget = pickupTarget;

        // Interaction
        const isFreshInteract = input.interact && !player.isInteracting;
        if (isFreshInteract) {
            player.isInteracting = true;
            player.interactTimer = 0;
            if (interactableTarget) {
                this.handleInteraction(player, interactableTarget);
            }
        }

        if (player.isInteracting) {
            player.interactTimer += dt;
            if (player.interactTimer > 0.4) {
                player.isInteracting = false;
                player.interactTimer = 0;
            }
        }

        // Dialogue Check
        this.checkNPCInteraction(player, entities);

        if (input.isPickingUp) {
            if (player.canSkin && !player.isSkinning && !player.isPickingUp) {
                player.isSkinning = true;
                player.skinningTimer = 0;
            } else if (pickupTarget && !player.isSkinning && !player.isPickingUp) {
                const itemName = pickupTarget.userData.pickupItem;
                const count = pickupTarget.userData.pickupCount ?? 1;
                if (itemName && player.addItem(itemName, count, true)) {
                    player.isPickingUp = true;
                    pickupTarget.userData.onPickup?.();
                    player.pickupTarget = null;
                }
            }
        }

        if (player.isSkinning) {
            // Cancel if moving
            if (input.x !== 0 || input.y !== 0 || input.jump) {
                player.isSkinning = false;
                player.skinningTimer = 0;
                player.skinningProgress = 0;
            } else {
                player.skinningTimer += dt;
                player.skinningProgress = Math.min(player.skinningTimer / player.maxSkinningTime, 1.0);
                
                if (player.skinningTimer >= player.maxSkinningTime) {
                    player.isSkinning = false;
                    player.skinningTimer = 0;
                    const skinRewards = this.getSkinRewards(skinnableTarget);
                    if (skinRewards.length > 0) {
                        for (const reward of skinRewards) {
                            player.addItem(reward.itemName, reward.count, true);
                        }
                    } else {
                        player.addItem('Fur'); 
                    }

                    // Mark as harvested so it can't be skinned again
                    if (skinnableTarget) {
                        // Check if it's a living entity like a Wolf
                        const entityRoot = skinnableTarget.parent?.userData.type === 'creature' ? skinnableTarget.parent : skinnableTarget;
                        const entity = entityRoot.userData.parent;

                        if (entity && typeof entity.markAsSkinned === 'function') {
                            entity.markAsSkinned();
                        } else {
                            // Fallback for static objects
                            skinnableTarget.userData.isSkinnable = false;
                            skinnableTarget.userData.type = 'soft'; // Disable collision
                            skinnableTarget.traverse(c => {
                                c.userData.isSkinnable = false;
                                c.userData.type = 'soft';
                            });
                        }
                    }
                }
            }
        } else {
            player.skinningProgress = 0;
        }
    }

    private static getSkinRewards(target: THREE.Object3D | null): { itemName: string; count: number }[] {
        if (!target) return [];

        const entityRoot = target.parent?.userData.type === 'creature' ? target.parent : target;
        const rewards = entityRoot.userData.skinRewards ?? target.userData.skinRewards ?? entityRoot.userData.skinReward ?? target.userData.skinReward;

        if (Array.isArray(rewards)) {
            return rewards
                .map((reward: any) => ({
                    itemName: reward?.itemName ?? reward?.name,
                    count: Math.max(0, Math.floor(reward?.count ?? 0))
                }))
                .filter((reward: { itemName: string; count: number }) => !!reward.itemName && reward.count > 0);
        }

        if (rewards && typeof rewards === 'object') {
            const itemName = rewards.itemName ?? rewards.name;
            const count = Math.max(0, Math.floor(rewards.count ?? 0));
            return itemName && count > 0 ? [{ itemName, count }] : [];
        }

        return [];
    }

    private static readonly _tempVec = new THREE.Vector3();

    private static getSkinnableTargetNearby(player: Player, obstacles: THREE.Object3D[]): THREE.Object3D | null {
        const skinnables = obstacles.filter(o => o.userData.isSkinnable);
        let best = null;
        let minDist = 1.5;

        for (const sk of skinnables) {
            sk.getWorldPosition(this._tempVec);
            const dist = player.mesh.position.distanceTo(this._tempVec);
            if (dist < minDist) { 
                minDist = dist;
                best = sk;
            }
        }
        return best;
    }

    private static getInteractableTargetNearby(player: Player, obstacles: THREE.Object3D[]): THREE.Object3D | null {
        const interactables = obstacles.filter(o => o.userData.interactType);
        let best = null;
        let minDist = 2.0;

        for (const it of interactables) {
            it.getWorldPosition(this._tempVec);
            const dist = player.mesh.position.distanceTo(this._tempVec);
            if (dist < minDist) { 
                minDist = dist;
                best = it;
            }
        }
        return best;
    }

    private static getPickupTargetNearby(player: Player, obstacles: THREE.Object3D[]): THREE.Object3D | null {
        const pickups = obstacles.filter(o => o.userData.pickupItem);
        let best = null;
        let minDist = 1.6;

        for (const pickup of pickups) {
            pickup.getWorldPosition(this._tempVec);
            const dist = player.mesh.position.distanceTo(this._tempVec);
            if (dist < minDist) {
                minDist = dist;
                best = pickup;
            }
        }
        return best;
    }

    private static handleInteraction(player: Player, target: THREE.Object3D): void {
        const interactType = target.userData.interactType;
        
        switch (interactType) {
            case 'door':
                const door = target.userData.door;
                if (door && typeof door.interact === 'function') {
                    door.interact();
                }
                break;
            // Add other interaction types here as needed
            default:
                console.log(`Unknown interaction type: ${interactType}`);
                break;
        }
    }

    private static checkNPCInteraction(player: Player, entities: any[]) {
        player.canTalk = false;
        player.talkingTarget = null;
        let closestTarget: any = null;
        let closestDistance = Infinity;

        for (const entity of entities) {
            const name = entity.constructor.name;
            const interactionRadius = entity?.group?.userData?.interactionRadius ?? 2.5;
            const canTalk = !!entity?.group?.userData?.canTalk;
            const dist = player.mesh.position.distanceTo(entity.position);
            
            // Check Guards
            if (name === 'LowLevelCityGuard' || entity instanceof LowLevelCityGuard) {
                if (entity.isInCombat()) continue;
                if (dist < 2.0 && dist < closestDistance) {
                    closestDistance = dist;
                    closestTarget = entity;
                }
                continue;
            }
            // Check Blacksmith
            if (name === 'Blacksmith' || entity instanceof Blacksmith) {
                if (dist < 2.5 && dist < closestDistance) { 
                    closestDistance = dist;
                    closestTarget = entity;
                }
                continue;
            }
            // Check Shopkeeper
            if (name === 'Shopkeeper' || entity instanceof Shopkeeper) {
                if (dist < 2.5 && dist < closestDistance) {
                    closestDistance = dist;
                    closestTarget = entity;
                }
                continue;
            }

            if (canTalk && dist < interactionRadius && dist < closestDistance) {
                closestDistance = dist;
                closestTarget = entity;
            }
        }

        if (closestTarget) {
            player.canTalk = true;
            player.talkingTarget = closestTarget;
        }
    }
}
