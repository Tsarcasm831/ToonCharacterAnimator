export interface GeneratedTrack {
    id: string;
    title: string;
    artist: string;
    duration: string;
    fileUrl: string;
}

export interface GeneratedAlbum {
    id: string;
    title: string;
    artist: string;
    year: string;
    genre: string;
    coverColor: string;
    coverImage?: string;
    spotifyUrl?: string;
    tracks: GeneratedTrack[];
}

export interface GeneratedFeaturedTrack {
    trackId: string;
    albumId: string;
    coverImage?: string;
    spotifyUrl?: string;
    accentColor: string;
    tagline: string;
}

export const AUTO_GENERATED_SINGLE_ALBUMS: GeneratedAlbum[] = [];

export const AUTO_GENERATED_FEATURED_TRACKS: GeneratedFeaturedTrack[] = [];
