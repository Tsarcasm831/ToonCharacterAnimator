import { supabase } from "@/lib/supabase";

export type GameSaveData = {
  playerState: unknown;
  inventoryState: unknown;
  questState?: unknown;
  gameState?: unknown;
};

export async function loadGameSave(slotName = "main") {
  const {
    data: { user },
    error: userError,
  } = await supabase.auth.getUser();

  if (userError) throw userError;
  if (!user) throw new Error("No authenticated user");

  const { data, error } = await supabase
    .from("game_saves")
    .select("*")
    .eq("user_id", user.id)
    .eq("slot_name", slotName)
    .maybeSingle();

  if (error) throw error;
  return data;
}

export async function saveGame(slotName: string, saveData: GameSaveData) {
  const {
    data: { user },
    error: userError,
  } = await supabase.auth.getUser();

  if (userError) throw userError;
  if (!user) throw new Error("No authenticated user");

  const { data, error } = await supabase
    .from("game_saves")
    .upsert(
      {
        user_id: user.id,
        slot_name: slotName,
        version: 1,
        save_data: saveData,
      },
      { onConflict: "user_id,slot_name" }
    )
    .select()
    .single();

  if (error) throw error;
  return data;
}